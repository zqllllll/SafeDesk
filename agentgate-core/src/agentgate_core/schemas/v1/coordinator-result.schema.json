{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "allow",
        "deny",
        "replan",
        "require_evidence",
        "require_confirmation",
        "require_approval",
        "already_applied",
        "defer"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "FeatureMode": {
      "enum": [
        "off",
        "shadow",
        "enforce"
      ],
      "title": "FeatureMode",
      "type": "string"
    },
    "FeatureName": {
      "enum": [
        "state_verification",
        "tool_execution_guard",
        "recovery_controller",
        "context_manager"
      ],
      "title": "FeatureName",
      "type": "string"
    },
    "GateDecision": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "effective_outcome": {
          "$ref": "#/$defs/DecisionOutcome"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "feature": {
          "$ref": "#/$defs/FeatureName"
        },
        "mode": {
          "$ref": "#/$defs/FeatureMode"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "proposed_outcome": {
          "$ref": "#/$defs/DecisionOutcome"
        },
        "reason_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/PipelineStage"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "task_id",
        "action_id",
        "feature",
        "stage",
        "mode",
        "proposed_outcome",
        "effective_outcome",
        "reason_code",
        "explanation"
      ],
      "title": "GateDecision",
      "type": "object"
    },
    "JsonValue": {},
    "PipelineStage": {
      "enum": [
        "task_state",
        "schema_guard",
        "dependency_scheduler",
        "policy_gate",
        "effect_preflight",
        "post_action_verification",
        "failure_classifier",
        "completion_gate",
        "response_grounding",
        "context_builder"
      ],
      "title": "PipelineStage",
      "type": "string"
    }
  },
  "$id": "https://schemas.safedesk.dev/agentgate/v1/coordinator-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stopped_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "trace_event_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Trace Event Ids",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "run_id",
    "action_id",
    "outcome"
  ],
  "title": "CoordinatorResult",
  "type": "object"
}
