{
  "$id": "https://schemas.safedesk.dev/agentgate/v1/raw-trace-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_type": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Content Type",
      "type": "string"
    },
    "estimated_tokens": {
      "minimum": 0,
      "title": "Estimated Tokens",
      "type": "integer"
    },
    "event_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Event Ids",
      "type": "array"
    },
    "reference_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reference Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "reference_id",
    "task_id",
    "run_id",
    "event_ids",
    "content_type",
    "estimated_tokens"
  ],
  "title": "RawTraceReference",
  "type": "object"
}
