{
  "$defs": {
    "ResponseClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ResponseClaimType"
        },
        "end_offset": {
          "minimum": 1,
          "title": "End Offset",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "text",
        "start_offset",
        "end_offset"
      ],
      "title": "ResponseClaim",
      "type": "object"
    },
    "ResponseClaimType": {
      "enum": [
        "success",
        "partial",
        "failure",
        "unknown",
        "waiting_confirmation",
        "waiting_approval"
      ],
      "title": "ResponseClaimType",
      "type": "string"
    }
  },
  "$id": "https://schemas.safedesk.dev/agentgate/v1/response-grounding-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResponseClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "completion_decision_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Decision Id"
    },
    "decision_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "downgraded": {
      "default": false,
      "title": "Downgraded",
      "type": "boolean"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "grounded_response": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Grounded Response",
      "type": "string"
    },
    "grounded_status": {
      "$ref": "#/$defs/ResponseClaimType"
    },
    "original_response": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Original Response",
      "type": "string"
    },
    "reason": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "requested_status": {
      "$ref": "#/$defs/ResponseClaimType"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "task_id",
    "run_id",
    "original_response",
    "grounded_response",
    "requested_status",
    "grounded_status",
    "reason"
  ],
  "title": "ResponseGroundingDecision",
  "type": "object"
}
