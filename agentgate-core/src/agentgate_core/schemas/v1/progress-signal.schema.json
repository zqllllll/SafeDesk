{
  "$id": "https://schemas.safedesk.dev/agentgate/v1/progress-signal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completion_conditions_gained": {
      "default": 0,
      "minimum": 0,
      "title": "Completion Conditions Gained",
      "type": "integer"
    },
    "new_resource_ids": {
      "default": 0,
      "minimum": 0,
      "title": "New Resource Ids",
      "type": "integer"
    },
    "new_verified_effects": {
      "default": 0,
      "minimum": 0,
      "title": "New Verified Effects",
      "type": "integer"
    },
    "new_verified_evidence": {
      "default": 0,
      "minimum": 0,
      "title": "New Verified Evidence",
      "type": "integer"
    },
    "resolved_failures": {
      "default": 0,
      "minimum": 0,
      "title": "Resolved Failures",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_transitions": {
      "default": 0,
      "minimum": 0,
      "title": "State Transitions",
      "type": "integer"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "token_growth": {
      "default": 0,
      "minimum": 0,
      "title": "Token Growth",
      "type": "integer"
    },
    "turn": {
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "turn"
  ],
  "title": "ProgressSignal",
  "type": "object"
}
