{
  "$defs": {
    "ActionIR": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/ActorKind"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "dependency_action_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Dependency Action Ids",
          "type": "array"
        },
        "expected_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExpectedEffect"
          },
          "title": "Expected Effects",
          "type": "array"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "operation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "required_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Evidence Ids",
          "type": "array"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_turn": {
          "minimum": 0,
          "title": "Source Turn",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_schema_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tool Schema Version",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "task_id",
        "actor",
        "kind",
        "tool_name",
        "operation",
        "tool_schema_version",
        "source_turn"
      ],
      "title": "ActionIR",
      "type": "object"
    },
    "ActionKind": {
      "enum": [
        "read",
        "write"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ActorKind": {
      "enum": [
        "user",
        "lead_agent",
        "subagent",
        "runtime",
        "recovery_controller"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "EffectKind": {
      "enum": [
        "create",
        "update",
        "delete",
        "send",
        "submit",
        "session",
        "other"
      ],
      "title": "EffectKind",
      "type": "string"
    },
    "ExpectedEffect": {
      "additionalProperties": false,
      "properties": {
        "effect_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Effect Key",
          "type": "string"
        },
        "expected_change": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Expected Change",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/EffectKind"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "effect_key",
        "kind",
        "resource"
      ],
      "title": "ExpectedEffect",
      "type": "object"
    },
    "FailureType": {
      "enum": [
        "missing_evidence",
        "invalid_argument",
        "out_of_schema",
        "wrong_tool",
        "wrong_resource",
        "dependency_not_satisfied",
        "policy_denied",
        "approval_required",
        "tool_execution_error",
        "tool_timeout",
        "authentication_failed",
        "permission_denied",
        "rate_limited",
        "partial_completion",
        "verification_failed",
        "duplicate_action",
        "unintended_side_effect",
        "no_progress",
        "context_degraded",
        "infrastructure_error"
      ],
      "title": "FailureType",
      "type": "string"
    },
    "JsonValue": {},
    "RecoveryState": {
      "enum": [
        "detected",
        "classified",
        "state_refreshed",
        "planned",
        "policy_checked",
        "executing",
        "verifying",
        "recovered",
        "failed",
        "budget_exhausted"
      ],
      "title": "RecoveryState",
      "type": "string"
    },
    "RecoveryStrategyType": {
      "enum": [
        "collect_evidence",
        "repair_arguments",
        "resolve_tool",
        "relocate_resource",
        "reschedule",
        "request_confirmation",
        "request_approval",
        "verify_before_retry",
        "repair_verification",
        "complete_missing_subgoal",
        "rebuild_context",
        "infrastructure_retry",
        "stop"
      ],
      "title": "RecoveryStrategyType",
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "resource_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        }
      },
      "required": [
        "resource_type"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "TaskPhase": {
      "enum": [
        "collect",
        "act",
        "verify",
        "repair",
        "complete",
        "blocked",
        "failed"
      ],
      "title": "TaskPhase",
      "type": "string"
    }
  },
  "$id": "https://schemas.safedesk.dev/agentgate/v1/recovery-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failure_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Failure Id",
      "type": "string"
    },
    "failure_type": {
      "$ref": "#/$defs/FailureType"
    },
    "instructions": {
      "default": [],
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Instructions",
      "type": "array"
    },
    "plan_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recommended_phase": {
      "$ref": "#/$defs/TaskPhase"
    },
    "repaired_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionIR"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "required_evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Evidence Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RecoveryState",
      "default": "planned"
    },
    "strategy_type": {
      "$ref": "#/$defs/RecoveryStrategyType"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "verify_before_execution": {
      "default": false,
      "title": "Verify Before Execution",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "task_id",
    "failure_id",
    "failure_type",
    "strategy_type",
    "recommended_phase",
    "reason"
  ],
  "title": "RecoveryPlan",
  "type": "object"
}
