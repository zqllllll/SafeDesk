{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "allow",
        "deny",
        "replan",
        "require_evidence",
        "require_confirmation",
        "require_approval",
        "already_applied",
        "defer"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.safedesk.dev/agentgate/v1/policy-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "matched_rule_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Matched Rule Ids",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "reason": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "action_id",
    "outcome",
    "reason"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
