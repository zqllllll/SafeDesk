{
  "$defs": {
    "ContextInvariantCode": {
      "enum": [
        "original_goal_missing",
        "hard_constraint_missing",
        "active_subgoal_missing",
        "verified_evidence_missing",
        "evidence_status_upgraded",
        "unresolved_effect_missing",
        "open_failure_missing",
        "resource_id_changed",
        "confirmation_state_changed",
        "state_version_mismatch"
      ],
      "title": "ContextInvariantCode",
      "type": "string"
    },
    "ContextInvariantViolation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ContextInvariantCode"
        },
        "message": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "reference_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "reference_id",
        "message"
      ],
      "title": "ContextInvariantViolation",
      "type": "object"
    }
  },
  "$id": "https://schemas.safedesk.dev/agentgate/v1/context-invariant-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_version": {
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "violations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextInvariantViolation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "state_version",
    "valid"
  ],
  "title": "ContextInvariantReport",
  "type": "object"
}
